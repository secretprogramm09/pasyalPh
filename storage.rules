rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Admin profile photos: only the owning admin can read/write their own folder.
    match /admin-profiles/{uid}/** {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Listing cover images: any signed-in admin can upload/view listing images.
    match /listing-images/{listingId}/** {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp',
        ];
    }
  }
}
